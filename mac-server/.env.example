# Copy this file to mac-server/.env and fill it in. .env is gitignored: the key never goes in the
# repo, the Android app, or a chat message.

# From https://developers.aivana.ai/api-keys (starts with ai_live_). Shown once when created.
AIVANA_API_KEY=

# Optional. How much reasoning Aivana may apply: auto | low | medium | high. Low is fastest.
AIVANA_EFFORT=low
