# Copy this file to mac-server/.env and fill it in. .env is gitignored: the key never goes in the
# repo, the Android app, or a chat message.

# From https://developers.aivana.ai/api-keys (starts with ai_live_). Shown once when created.
AIVANA_API_KEY=

# Only needed for Wi-Fi (HOST=0.0.0.0 ./run.sh). Any long random string; put the same one in the
# app under Settings -> Server token. Without it, only requests from this Mac (USB) are answered.
# Make one with:  openssl rand -hex 24
BOMBIRDIER_TOKEN=

# Optional. The assistant's voice: af_heart (US female, default), am_michael (US male),
# bm_george (British male)... Leave empty after the = to use the phone's built-in voice instead.
# TTS_VOICE=af_heart

# Optional. How much reasoning Aivana may apply: auto | low | medium | high. Low is fastest.
AIVANA_EFFORT=low
